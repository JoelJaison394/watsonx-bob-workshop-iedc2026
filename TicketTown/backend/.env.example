# Copy to .env (never commit .env). Loaded automatically on start.

# TMDB: either a v3 API key or a v4 "API Read Access Token".
# Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Optional
# USE_TMDB=false        # force the built-in demo movies even if a key is set
# TMDB_REGION=IN
# TMDB_LIMIT=12
# ADMIN_KEY=change-me
# HOLD_MINUTES=10
# PORT=3000
